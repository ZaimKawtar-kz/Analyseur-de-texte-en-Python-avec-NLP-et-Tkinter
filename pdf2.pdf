   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">639335008</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Photo by Mike Kline (notkalvin)</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">This view of the rear of the US Capitol Building shows the full width of the structure in detail. A lone person is riding by the building on a bicycle, and is centered in the image. The blue sky is complimented with a smattering of puffy clouds.</rdf:li>
    </rdf:Alt>
   </dc:description>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

